APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgres://bwims:bwims@127.0.0.1:5432/bwims?sslmode=disable
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
JWT_ISSUER=bwims-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Production requires base64-encoded PKCS#8 private and PKIX public RSA keys.
# Development generates an ephemeral RS256 key pair when these are empty.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
